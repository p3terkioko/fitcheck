# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Database Configuration - PostgreSQL with pgvector
DATABASE_URL=postgresql://username:password@host:port/database_name
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password

# Service Ports
NODE_PORT=3000
PYTHON_PORT=8000

# ML Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI Whisper API (for social media URL transcription)
OPENAI_API_KEY=your_openai_api_key_here

# Audio pipeline paths (auto-detected if in PATH or project bin/)
# YTDLP_PATH=/path/to/yt-dlp
# FFMPEG_PATH=/path/to/ffmpeg

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (for verifying Supabase JWTs — find in Supabase project settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PubMed (for enriching evidence card links — optional, slower rate limits without it)
PUBMED_API_KEY=your-pubmed-api-key

# Computed ML service URL (defaults to http://localhost:PYTHON_PORT)
ML_SERVICE_URL=http://localhost:8000

# Security Notes:
# - Use strong, unique passwords
# - Never commit actual credentials to git
# - Rotate API keys regularly
# - Use environment variables in production